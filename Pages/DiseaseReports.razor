@page "/disease-reports"

<PageTitle>Донесения об особо опасных болезнях животных</PageTitle>

@using Blazor1.Data
@using Blazor1.Models
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation

<h1>Донесения об особо опасных болезнях животных</h1>

<div class="mb-3">
    <a href="/disease-reports/create" class="btn btn-primary">
        <span class="oi oi-plus" aria-hidden="true"></span> Новое донесение
    </a>
</div>

@if (reports == null)
{
    <p><em>Загрузка...</em></p>
}
else if (reports.Count == 0)
{
    <div class="alert alert-info">
        Донесений не найдено. <a href="/disease-reports/create">Создать новое</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Дата</th>
                    <th>Район</th>
                    <th>Болезнь</th>
                    <th>Вид животного</th>
                    <th>Заболевшие</th>
                    <th>Павшие</th>
                    <th>Место выявления</th>
                    <th>Ответственный</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in reports)
                {
                    <tr>
                        <td>@report.ReportDate.ToShortDateString()</td>
                        <td>@report.District</td>
                        <td>@report.DiseaseName</td>
                        <td>@report.AnimalType</td>
                        <td>@report.SickCount</td>
                        <td>@report.DeadCount</td>
                        <td>@report.Location</td>
                        <td>@report.ResponsiblePerson</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<DiseaseReport>? reports;

    protected override async Task OnInitializedAsync()
    {
        reports = DbContext.DiseaseReports.OrderByDescending(x => x.ReportDate).ToList();
    }
}
